{
  "secrets": [
    {
      "name": "deployment-token",
      "purpose": "Deploy the application",
      "required": true,
      "sources": [
        {"type": "env", "var": "DEPLOYMENT_TOKEN"},
        {"type": "file", "path": ".secrets/deployment-token"},
        {"type": "command", "check": ["deployctl", "auth", "status"]}
      ],
      "used_by": ["deploy"]
    }
  ]
}
