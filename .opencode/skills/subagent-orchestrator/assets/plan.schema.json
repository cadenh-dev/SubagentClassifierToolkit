{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cadenh-dev/SubagentClassifierToolkit/subagent-plan.schema.json",
  "title": "Subagent delegation plan",
  "type": "object",
  "required": ["goal", "mode", "units", "integration"],
  "additionalProperties": false,
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence describing the overall outcome."
    },
    "mode": {
      "type": "string",
      "enum": ["single", "delegated"],
      "description": "single means the parent does the work; delegated means at least one unit is launched."
    },
    "ignore_cost": {
      "type": "boolean",
      "default": false,
      "description": "When true, maximize reasoning among eligible targets."
    },
    "units": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "role",
          "objective",
          "depends_on",
          "isolation",
          "mode",
          "acceptance",
          "deliverable",
          "brief"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": ["research", "design", "implementation", "test", "review", "general"]
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "isolation": {
            "type": "string",
            "enum": ["shared", "worktree"]
          },
          "mode": {
            "type": "string",
            "enum": ["async", "wait"]
          },
          "target": {
            "type": "object",
            "required": ["providerInstanceId", "model"],
            "additionalProperties": false,
            "properties": {
              "providerInstanceId": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "options": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": ["string", "boolean", "number"]
                    }
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id", "value"],
                      "additionalProperties": false,
                      "properties": {
                        "id": { "type": "string", "minLength": 1 },
                        "value": { "type": ["string", "boolean", "number"] }
                      }
                    }
                  }
                ]
              }
            }
          },
          "write_scope": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "commands": {
            "type": "array",
            "items": { "type": "string" }
          },
          "deliverable": {
            "type": "string",
            "minLength": 1
          },
          "brief": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "integration": {
      "type": "object",
      "required": ["order", "tests", "review"],
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Integration order by unit id."
        },
        "tests": {
          "type": "array",
          "items": { "type": "string" }
        },
        "review": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "fallback": {
      "type": "string",
      "description": "What the parent does if no target is eligible or a unit fails."
    }
  }
}
